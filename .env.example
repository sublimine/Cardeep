# Cardeep environment variables. Each has a built-in default (in code) that already
# matches the local cardeep-pg from docker-compose, so LOCAL RUNS WITH ZERO SETUP.
# This file is a REFERENCE — the app reads os.environ and does NOT auto-load a .env.
# To override, export these into your environment (or `source` this file). NEVER commit a real .env.

# PostgreSQL backbone (dev default; container cardeep-pg on port 5433)
# CARDEEP_DSN    → async driver (asyncpg): the API + pipeline
# CARDEEP_DB_URL → sync driver (psycopg2): the durable scheduler's SQLAlchemy jobstore
CARDEEP_DSN=postgres://cardeep:cardeep_dev_only@localhost:5433/cardeep
CARDEEP_DB_URL=postgresql+psycopg2://cardeep:cardeep_dev_only@localhost:5433/cardeep

# Local LLM for the cheap/massive layer (classify, parse, dedup)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Paid escalation (gated by owner — leave empty until authorized)
# DECODO_PROXY=
# CAPSOLVER_KEY=
