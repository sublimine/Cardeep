{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",

  "build": {
    "env": {
      "VITE_API_BASE": "/api"
    }
  },

  "rewrites": [
    { "source": "/api/v1/:path*", "destination": "https://movers-sparc-downtown-quizzes.trycloudflare.com/:path*" },
    { "source": "/api/:path*", "destination": "https://movers-sparc-downtown-quizzes.trycloudflare.com/:path*" },
    { "source": "/workspace-assets/:path*", "destination": "https://cardeep-workspace.vercel.app/workspace-assets/:path*" },

    { "source": "/login", "destination": "https://cardeep-workspace.vercel.app/login" },
    { "source": "/register", "destination": "https://cardeep-workspace.vercel.app/register" },
    { "source": "/reset", "destination": "https://cardeep-workspace.vercel.app/reset" },
    { "source": "/2fa", "destination": "https://cardeep-workspace.vercel.app/2fa" },
    { "source": "/dashboard", "destination": "https://cardeep-workspace.vercel.app/dashboard" },
    { "source": "/dashboard/:path*", "destination": "https://cardeep-workspace.vercel.app/dashboard/:path*" },
    { "source": "/vehicles", "destination": "https://cardeep-workspace.vercel.app/vehicles" },
    { "source": "/vehicles/:path*", "destination": "https://cardeep-workspace.vercel.app/vehicles/:path*" },
    { "source": "/kanban", "destination": "https://cardeep-workspace.vercel.app/kanban" },
    { "source": "/contacts", "destination": "https://cardeep-workspace.vercel.app/contacts" },
    { "source": "/contacts/:path*", "destination": "https://cardeep-workspace.vercel.app/contacts/:path*" },
    { "source": "/deals", "destination": "https://cardeep-workspace.vercel.app/deals" },
    { "source": "/deals/:path*", "destination": "https://cardeep-workspace.vercel.app/deals/:path*" },
    { "source": "/inbox", "destination": "https://cardeep-workspace.vercel.app/inbox" },
    { "source": "/publicaciones", "destination": "https://cardeep-workspace.vercel.app/publicaciones" },
    { "source": "/calendar", "destination": "https://cardeep-workspace.vercel.app/calendar" },
    { "source": "/finance", "destination": "https://cardeep-workspace.vercel.app/finance" },
    { "source": "/inteligencia", "destination": "https://cardeep-workspace.vercel.app/inteligencia" },
    { "source": "/arbitrage", "destination": "https://cardeep-workspace.vercel.app/arbitrage" },
    { "source": "/api-tokens", "destination": "https://cardeep-workspace.vercel.app/api" },
    { "source": "/analitica", "destination": "https://cardeep-workspace.vercel.app/analitica" },
    { "source": "/marketing", "destination": "https://cardeep-workspace.vercel.app/marketing" },
    { "source": "/terminal", "destination": "https://cardeep-workspace.vercel.app/terminal" },
    { "source": "/terminal/:path*", "destination": "https://cardeep-workspace.vercel.app/terminal/:path*" },
    { "source": "/settings", "destination": "https://cardeep-workspace.vercel.app/settings" },
    { "source": "/assistant", "destination": "https://cardeep-workspace.vercel.app/assistant" },
    { "source": "/motor", "destination": "https://cardeep-workspace.vercel.app/motor" },
    { "source": "/invoices", "destination": "https://cardeep-workspace.vercel.app/invoices" },
    { "source": "/invoices/:path*", "destination": "https://cardeep-workspace.vercel.app/invoices/:path*" },
    { "source": "/notes", "destination": "https://cardeep-workspace.vercel.app/notes" },
    { "source": "/profile", "destination": "https://cardeep-workspace.vercel.app/profile" },
    { "source": "/support", "destination": "https://cardeep-workspace.vercel.app/support" },
    { "source": "/community", "destination": "https://cardeep-workspace.vercel.app/community" },
    { "source": "/community/:path*", "destination": "https://cardeep-workspace.vercel.app/community/:path*" },
    { "source": "/marketplace", "destination": "https://cardeep-workspace.vercel.app/marketplace" },
    { "source": "/marketplace/:path*", "destination": "https://cardeep-workspace.vercel.app/marketplace/:path*" },

    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    }
  ]
}
