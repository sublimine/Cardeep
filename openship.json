{
  "$schema": "https://openship.io/openship.schema.json",
  "services": [
    {
      "name": "cardeep-pg",
      "image": "postgres:16",
      "env": {
        "POSTGRES_USER": "cardeep",
        "POSTGRES_DB": "cardeep",
        "POSTGRES_PASSWORD": { "value": "cardeep_dev_only", "secret": true }
      },
      "volumes": ["cardeep_pg_data:/var/lib/postgresql/data"],
      "restart": "unless-stopped",
      "exposed": false,
      "healthcheck": {
        "test": ["CMD-SHELL", "pg_isready -U cardeep -d cardeep"],
        "interval": "10s",
        "timeout": "5s",
        "retries": 5
      }
    },
    {
      "name": "api",
      "build": ".",
      "dockerfile": "Dockerfile",
      "command": "uvicorn services.api.main:app --host 0.0.0.0 --port 8090",
      "ports": ["8090"],
      "dependsOn": ["cardeep-pg"],
      "env": {
        "CARDEEP_DSN": { "value": "postgresql://cardeep:cardeep_dev_only@cardeep-pg:5432/cardeep", "secret": true },
        "CARDEEP_ASYNCPG_DSN": { "value": "postgresql://cardeep:cardeep_dev_only@cardeep-pg:5432/cardeep", "secret": true },
        "CARDEEP_DB_URL": { "value": "postgresql+psycopg2://cardeep:cardeep_dev_only@cardeep-pg:5432/cardeep", "secret": true },
        "CARDEEP_OLLAMA_URL": "http://host.docker.internal:11434/api/generate",
        "CARDEEP_LLM_MODEL": "qwen2.5:7b"
      },
      "restart": "unless-stopped",
      "exposed": true,
      "healthcheck": {
        "test": ["CMD-SHELL", "python -c \"import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:8090/health').status==200 else 1)\""],
        "interval": "30s",
        "timeout": "5s",
        "retries": 3
      }
    },
    {
      "name": "autopilot",
      "build": ".",
      "dockerfile": "Dockerfile",
      "command": "python -m pipeline.ops.scheduler",
      "dependsOn": ["cardeep-pg"],
      "env": {
        "CARDEEP_DSN": { "value": "postgresql://cardeep:cardeep_dev_only@cardeep-pg:5432/cardeep", "secret": true },
        "CARDEEP_ASYNCPG_DSN": { "value": "postgresql://cardeep:cardeep_dev_only@cardeep-pg:5432/cardeep", "secret": true },
        "CARDEEP_DB_URL": { "value": "postgresql+psycopg2://cardeep:cardeep_dev_only@cardeep-pg:5432/cardeep", "secret": true },
        "CARDEEP_OLLAMA_URL": "http://host.docker.internal:11434/api/generate",
        "CARDEEP_LLM_MODEL": "qwen2.5:7b"
      },
      "restart": "unless-stopped",
      "exposed": false
    },
    {
      "name": "web",
      "build": "web",
      "dockerfile": "Dockerfile",
      "ports": ["80"],
      "dependsOn": ["api"],
      "restart": "unless-stopped",
      "exposed": true,
      "healthcheck": {
        "test": ["CMD-SHELL", "wget -qO- http://127.0.0.1/ >/dev/null || exit 1"],
        "interval": "30s",
        "timeout": "5s",
        "retries": 3
      }
    }
  ]
}
