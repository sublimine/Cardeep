# Ephemeral raw harvests — evicted by capacity policy, never versioned.
# Pattern is data/* (not data/) so a parent-dir exclusion does not block the re-include
# below — git cannot re-include a file whose parent directory is excluded outright.
data/*
# EXCEPTION: static INE reference gazetteers the resolver reads at runtime
# (Nomenclátor de núcleos, INE dictionaries) — versioned reference data, not harvests.
!data/geo/

# Secrets
.env
.env.*
!.env.example

# Volatile state (capacity ledger, run state)
state/

# Runtime noise
*.log
__pycache__/
*.pyc
.venv/
node_modules/
.pytest_cache/
.backups/
scratch/
scripts/_*.py
scratch_*.py
.runlogs/

# Dev clutter (scratch/audit one-offs, screenshots) - limpieza 2026-06-27
/scratch_*.py
/audit_*.py
/cardeep-*.png
/_audit_*.json
/ent*.json
/liveseal.json

# Obsidian per-session UI state (churns every time the vault opens, not shared config)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/graph.json
# Local REST API plugin's generated secret (API key + TLS cert), never versioned
.obsidian/plugins/obsidian-local-rest-api/data.json

# SessionEnd hook local state (per-machine checkpoint, not shared config)
.claude/second-brain-session-marker.json

# Graphify: 100% regenerated from the codebase (`graphify update .` +
# `graphify export obsidian --dir docs/second-brain/gf`), same treatment as
# data/ above — a derived build artifact, not source, never versioned.
graphify-out/
docs/second-brain/gf/
